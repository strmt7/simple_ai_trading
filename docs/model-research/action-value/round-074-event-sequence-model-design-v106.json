  "research_basis": [
    {
      "source": "https://docs.pytorch.org/docs/main/generated/torch.nn.utils.clip_grad_norm_.html",
      "finding": "PyTorch documents that clip_grad_norm_ computes the total norm across parameter gradients, modifies gradients in place, and returns the pre-clipping total norm.",
      "implementation_consequence": "The trainer reuses the already returned norm rather than adding a second norm pass or backward pass."
    },
    {
      "source": "https://proceedings.mlr.press/v80/chen18a.html",
      "finding": "GradNorm dynamically changes task loss weights to balance gradient magnitudes and task training rates.",
      "implementation_consequence": "GradNorm is not enabled without representative evidence that fixed auxiliary weights create harmful imbalance."
    },
    {
      "source": "https://papers.neurips.cc/paper_files/paper/2020/file/3fe78a8acf5fda99de95303940a2420c-Paper.pdf",
      "finding": "PCGrad defines conflict using negative task-gradient cosine similarity and projects conflicting per-task gradients before the optimizer update.",
      "implementation_consequence": "Total-gradient norm telemetry is not mislabeled as task-conflict evidence, and PCGrad remains a separately registered future ablation."
    },
    {
      "source": "https://proceedings.mlr.press/v162/navon22a.html",
      "finding": "Nash-MTL treats per-task gradient combination as a bargaining problem and introduces a distinct joint update procedure.",
      "implementation_consequence": "Nash-MTL is not introduced as an untested replacement for the current proper-loss objective."
    }
  ],
