  "research_basis": [
    {
      "source": "https://arxiv.org/abs/0704.3649",
      "finding": "Chernozhukov, Fernandez-Val, and Galichon monotonize crossing estimates by sorting or rearrangement; rearrangement preserves the estimated values instead of flattening crossed regions through one-sided projection.",
      "implementation_consequence": "The four independently predicted adverse-excursion horizon surfaces are elementwise rearranged rather than cumulatively clamped."
    },
    {
      "source": "https://www.jmlr.org/papers/v25/22-0488.html",
      "finding": "Non-crossing conditional quantiles are a formal modeling constraint, and constrained neural estimators can enforce it while retaining a joint quantile objective.",
      "implementation_consequence": "Within-horizon quantile order and across-horizon path-risk order remain hard output invariants."
    },
    {
      "source": "https://link.springer.com/article/10.1007/s00477-018-1573-6",
      "finding": "Non-negativity and monotonicity constraints can encode process knowledge and prevent physically invalid neural quantile surfaces.",
      "implementation_consequence": "Maximum adverse excursion remains nonnegative, non-crossing across quantiles, and nondecreasing across nested 1s, 5s, 30s, and 300s horizons."
    }
  ],
