  "research_basis": [
    {
      "source": "https://grpc.io/docs/guides/deadlines/",
      "finding": "Deadline propagation deducts elapsed time, and servers should stop work after the request can no longer complete usefully.",
      "implementation_consequence": "Historical queue age consumes the same source-bound action-validity budget as inference."
    },
    {
      "source": "https://docs.nvidia.com/deeplearning/triton-inference-server/user-guide/docs/user_guide/batcher.html",
      "finding": "Production inference schedulers support queue timeouts and rejection of requests that wait beyond their configured limit.",
      "implementation_consequence": "A queue-expired review is rejected before model inference rather than processed and discarded later."
    },
    {
      "source": "https://docs.nvidia.com/deeplearning/triton-inference-server/user-guide/docs/user_guide/metrics.html",
      "finding": "Queue duration is separate from compute duration, and scheduler timeout rejections are counted as failed requests.",
      "implementation_consequence": "Queue delay remains explicit evidence and queue-expired reviews count against AI qualification."
    },
    {
      "source": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3433739",
      "finding": "Limit-order-book state can change during processing and order submission, so latency changes executable liquidity.",
      "implementation_consequence": "Late AI decisions remain zero exposure and cannot inherit an earlier fill or payoff."
    }
  ],
