  "research_basis": [
    {
      "source": "https://doi.org/10.1198/016214506000001437",
      "finding": "Strictly proper scoring rules assess probabilistic forecasts by making the true predictive distribution optimal in expectation.",
      "implementation_consequence": "The existing eligible-target binary log scores remain attached to the two identifiable directional marginals; the model geometry now constrains those marginals to one feasible three-outcome distribution."
    },
    {
      "source": "https://docs.pytorch.org/docs/stable/generated/torch.nn.CrossEntropyLoss.html",
      "finding": "Categorical probabilities form a normalized class distribution, unlike unrelated independent class probabilities.",
      "implementation_consequence": "Two raw side scores are interpreted as the long and short coordinates of softmax over neither, long, and short while preserving the existing two-marginal output API."
    },
    {
      "source": "https://doi.org/10.1080/07350015.1995.10524599",
      "finding": "Predictive accuracy comparisons require out-of-sample loss evidence rather than architecture-level assertions.",
      "implementation_consequence": "The coherent head receives no promotion, accuracy, or edge claim before the frozen tuning and sealed-test protocol is executed."
    },
    {
      "source": "https://onlinelibrary.wiley.com/doi/abs/10.3982/ecta5771",
      "finding": "Multiple-model comparison needs explicit control of data-snooping uncertainty.",
      "implementation_consequence": "Candidate selection and AI uplift remain bound to the predeclared multi-model promotion gates; this structural correction does not bypass them."
    }
  ],
