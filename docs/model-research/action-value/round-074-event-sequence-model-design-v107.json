  "research_basis": [
    {
      "source": "mathematical consequence of the source-bound Round 74 target definition",
      "finding": "For one fixed entry and side, maximum adverse excursion, maximum favorable excursion, and maximum spread over a nested path cannot decrease as the observation horizon expands; minimum exit-side capacity cannot increase.",
      "implementation_consequence": "Eligible source labels that violate nested path extrema are rejected before training."
    },
    {
      "source": "https://proceedings.mlr.press/v151/brando22a.html",
      "finding": "Independent quantile-loss minimization does not guarantee a valid monotone quantile function, and monotonicity can be enforced by model construction.",
      "implementation_consequence": "The existing within-horizon non-crossing quantile construction remains mandatory, and path-risk coherence is now also enforced across ordered horizons."
    },
    {
      "source": "https://proceedings.mlr.press/v258/peng25a.html",
      "finding": "Distributional regression can be formulated to avoid quantile crossing inherently rather than relying on post-hoc visual interpretation.",
      "implementation_consequence": "Invalid path-risk distributions fail structurally instead of being tolerated as a reporting anomaly."
    },
    {
      "source": "https://docs.pytorch.org/docs/stable/generated/torch.maximum.html",
      "finding": "torch.maximum computes the elementwise maximum of two tensors.",
      "implementation_consequence": "Three elementwise running-maximum operations impose exact horizon coherence without new parameters or a CPU-only operator."
    }
  ],
