  "research_basis": [
    {
      "source": "https://doi.org/10.1198/016214506000001437",
      "finding": "Proper scoring rules assess probabilistic forecasts without rewarding strategically distorted distributions, and quantile scores are proper for quantile forecasts.",
      "implementation_consequence": "Sealed promotion now requires positive pinball skill for both net-payoff and maximum-adverse-excursion quantile heads."
    },
    {
      "source": "https://doi.org/10.2307/1913643",
      "finding": "Quantile estimation is based on the asymmetric absolute-loss objective underlying the pinball score.",
      "implementation_consequence": "Each forecast quantile is evaluated at its declared probability level rather than by point-error accuracy."
    },
    {
      "source": "https://doi.org/10.1080/01621459.1994.10476870",
      "finding": "The stationary bootstrap preserves local temporal dependence by resampling random-length blocks.",
      "implementation_consequence": "Quantile-score improvement is reduced to whole chronological capture runs before the existing circular stationary bootstrap."
    },
    {
      "source": "https://arxiv.org/abs/1503.08195",
      "finding": "Forecast comparison must use scoring functions consistent with the statistical functional being forecast.",
      "implementation_consequence": "Binary heads retain Brier scoring while continuous payoff and path-risk heads use quantile-consistent pinball scoring."
    }
  ],
