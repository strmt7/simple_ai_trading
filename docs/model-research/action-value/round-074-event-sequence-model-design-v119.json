  "research_basis": [
    {
      "source": "https://jmlr.org/papers/v17/14-294.html",
      "finding": "A coherent multiclass probability prediction represents all mutually exclusive outcomes rather than one marginal in isolation.",
      "implementation_consequence": "The AI packet now carries proposed-side positive, opposing-side positive, and neither-side positive probabilities from the calibrated v115 outcome distribution."
    },
    {
      "source": "https://proceedings.mlr.press/v333/lopez26a.html",
      "finding": "Selective prediction can fail despite strong aggregate metrics when uncertainty is class-dependently miscalibrated.",
      "implementation_consequence": "The deterministic qualification path does not trust AI confidence alone; it exposes the complete outcome context, preserves abstention, and still requires disjoint paired after-cost uplift."
    },
    {
      "source": "https://proceedings.mlr.press/v304/tayebati26a.html",
      "finding": "Context-adaptive abstention is intended to align risk control with instance-specific uncertainty instead of a single global confidence signal.",
      "implementation_consequence": "The prompt explicitly treats substantial opposing probability or a small directional margin as ambiguity that may reduce, veto, or abstain, never as authority to reverse the trade."
    }
  ],
