  "research_basis": [
    {
      "source": "https://doi.org/10.1198/016214506000001437",
      "finding": "A strictly proper score is optimized in expectation by the true predictive distribution.",
      "implementation_consequence": "Fully observed neither, long-positive, and short-positive outcomes use their exact categorical log score."
    },
    {
      "source": "https://jmlr.org/papers/v17/14-294.html",
      "finding": "Proper composite multiclass losses pair a probability-simplex prediction with a link while retaining probability-estimation consistency.",
      "implementation_consequence": "The v115 simplex-valued head is trained as one three-outcome distribution wherever both directional outcomes are observed."
    },
    {
      "source": "https://www.jmlr.org/papers/v11/reid10a.html",
      "finding": "Binary composite losses remain appropriate for estimating one observed event probability.",
      "implementation_consequence": "If target construction censors one trade direction, only the eligible directional marginal receives a binary log score; no target is invented for the unavailable side."
    },
    {
      "source": "https://docs.pytorch.org/docs/stable/generated/torch.nn.CrossEntropyLoss.html",
      "finding": "Categorical cross entropy represents mutually exclusive class-index or class-probability targets.",
      "implementation_consequence": "The loss explicitly builds the neither, long, and short probability vector and one-hot target instead of summing two negative Bernoulli terms for a fully observed categorical event."
    }
  ],
  "loss_contract": {
    "fully_observed_outcomes": [
      "neither_direction_positive_after_cost",
      "long_positive_after_cost",
      "short_positive_after_cost"
    ],
    "probabilities": {
      "p_long": "sigmoid_long_marginal_logit",
