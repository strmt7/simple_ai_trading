  "research_basis": [
    {
      "source": "https://doi.org/10.1080/14697688.2025.2515933",
      "finding": "Millions of live Binance and Bybit orders show latency, volatility, and liquidity drive adverse fill divergence; snapshot fills cannot be inherited after review delay.",
      "implementation_consequence": "Every surviving AI action requires delayed historical L2 replay."
    },
    {
      "source": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3433739",
      "finding": "The limit order book can update while a trader processes information and submits an order, so the intended fill is not guaranteed.",
      "implementation_consequence": "Latency is measured and changes replay timing instead of scaling the baseline payoff."
    },
    {
      "source": "https://arxiv.org/abs/2412.04856",
      "finding": "Tested LLMs generated frequently but achieved only 5 to 10 percent instruction accuracy and had substantial missing fields.",
      "implementation_consequence": "AI remains schema-validated, fail-closed, and limited to vetoing or reducing an ML-selected action."
    },
    {
      "source": "https://arxiv.org/abs/2502.15757",
      "finding": "A simple MLP can outperform more complex LOB models, while transaction-cost-aware evaluation materially degrades apparent predictability.",
      "implementation_consequence": "Model complexity is not treated as evidence of edge; after-cost paired replay remains authoritative."
    },
    {
      "source": "https://arxiv.org/abs/2505.02139",
      "finding": "LOB representation evaluation requires consistent preprocessing and attention to autocorrelation, cross-feature constraints, and scale disparity.",
      "implementation_consequence": "Future representation changes require isolated ablation and may not bypass the current causal scaler and disjoint split."
    },
    {
      "source": "https://arxiv.org/abs/2511.12563",
      "finding": "Message-level self-supervised LOB encoders are a plausible representation-learning direction.",
      "implementation_consequence": "LOB foundation pretraining is recorded as a future ablation, not deployed or credited with uplift."
    }
  ],
