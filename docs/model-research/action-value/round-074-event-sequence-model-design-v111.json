  "research_basis": [
    {
      "source": "https://doi.org/10.1609/aaai.v33i01.33019977",
      "finding": "Multi-task average performance can improve while an individual task deteriorates through negative transfer.",
      "implementation_consequence": "A challenger can no longer hide deterioration of a forecast head inside lower aggregate proper loss."
    },
    {
      "source": "https://papers.nips.cc/paper_files/paper/2018/hash/432aca3a1e345e339f35a30c8f65edce-Abstract.html",
      "finding": "Multi-task learning is a multi-objective problem in which scalarized aggregate loss does not expose every task trade-off.",
      "implementation_consequence": "Promotion now requires task-level non-degradation in addition to strict aggregate improvement."
    },
    {
      "source": "https://papers.nips.cc/paper_files/paper/2020/hash/3fe78a8acf5fda99de95303940a2420c-Abstract.html",
      "finding": "Shared multi-task models can suffer detrimental interference between task gradients.",
      "implementation_consequence": "The trainer does not claim conflict resolution, but every architecture and ablation promotion is blocked when a critical task becomes worse."
    },
    {
      "source": "https://doi.org/10.1198/016214506000001437",
      "finding": "Proper scores support coherent comparison of probabilistic forecasts.",
      "implementation_consequence": "Task non-degradation is measured with the existing pinball and binary cross-entropy proper losses, not backtest profit."
    }
  ],
