  "research_basis": [
    {
      "source": "https://docs.polymarket.com/market-data/chainlink-twap",
      "finding": "the direct RTDS source publishes exact signed E18 30-second rolling TWAP observations and no historical replay after disconnect",
      "design_consequence": "preserve exact E18 values, reject gaps, and do not reconstruct the proprietary TWAP"
    },
    {
      "source": "https://arxiv.org/abs/2602.00133",
      "finding": "prediction-market agent evaluation requires deterministic event replay, maker-taker semantics, fees, lifecycle, and settlement",
      "design_consequence": "predictive ranking precedes a separate event-time economic replay and no midpoint execution is allowed"
    },
    {
      "source": "https://arxiv.org/abs/2607.26245",
      "finding": "a synchronized Polymarket and Binance walk-forward study did not beat the market prior and a simplistic lead-lag strategy lost money",
      "design_consequence": "the market prior is a mandatory control and Binance remains a separately ablated optional predictor"
    },
    {
      "source": "https://arxiv.org/abs/2603.24137",
      "finding": "realistic limit-order-book evaluation is sensitive to latency, spread, imbalance, signed-flow impact, decay, and reversion",
      "design_consequence": "economic promotion requires event-time books, measured collector latency, partial fills, impact, decay, and reversion sensitivity"
    },
    {
      "source": "https://arxiv.org/abs/2602.07048",
      "finding": "an LLM improved prediction-market lead-lag portfolios primarily by filtering fragile relationships and reducing loss magnitude",
      "design_consequence": "local LLMs may only veto or reduce deterministic risk and must prove matched economic uplift"
    },
    {
      "source": "https://arxiv.org/abs/2605.19337",
      "finding": "most published LLM trading studies lack time-consistent splits, transaction costs, and reproducible execution semantics",
      "design_consequence": "all AI comparisons use sealed chronological populations, identical costs, exact model digests, and reproducible decision traces"
    }
  ],
