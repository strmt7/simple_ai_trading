[{"id":"4024835","question":"Will Chicago, IL face tornado risk on August 31?","conditionId":"0x1d0c1d840271740667d177375a828973ab3a31966ce308a7232f4290ec08e2e1","slug":"which-cities-face-tornado-risk-on-august-31-2026-chicago-il","resolutionSource":"https://www.spc.noaa.gov/products/outlook/day1otlk.html","endDate":"2026-09-01T12:00:00Z","liquidity":"51.74001","startDate":"2026-08-31T12:13:16Z","image":"https://polymarket-upload.s3.us-east-2.amazonaws.com/how-many-tornadoes-in-the-us-in-november-W7XLO0OomR-x.png","icon":"https://polymarket-upload.s3.us-east-2.amazonaws.com/how-many-tornadoes-in-the-us-in-november-W7XLO0OomR-x.png","description":"This market will resolve to \"Yes\" if Chicago, IL falls within a tornado probability area rated ≥2% in the NOAA Storm Prediction Center Day 1 Convective Outlook on August 31, 2026. Otherwise, this market will resolve to \"No\".\n\nThe SPC Day 1 Convective Outlook assigns tornado probability percentages (2%, 5%, 10%, etc.) to geographic areas across the US. If the city's coordinates fall inside any area rated 2% or higher, that city resolves \"Yes\". If a city is outside all tornado probability areas, or only within areas rated below 2%, that city resolves \"No\".\n\nThe SPC outlook is published as machine-readable geographic data (GeoJSON) at spc.noaa.gov. Each city's coordinates and the polygon boundaries are publicly verifiable. Borderline cases can be independently confirmed using the polygon data (excluding the hatched SIGN overlay, which is not a probability rating) and the city's listed coordinates. The point-in-polygon test is performed on unprojected WGS84 (EPSG:4326) coordinates, which is the native coordinate system of the SPC GeoJSON data.\n\nResolution is based on the scheduled 01:00 UTC Day 1 Convective Outlook update issued on the following UTC calendar day. The SPC Day 1 outlook covers a 24-hour period from 12:00 UTC to 12:00 UTC the following day. Subsequent revisions published after that scheduled update will not be considered. If the SPC outlook is not published or is unavailable, the market remains open until data is available.\n\nThe resolution source for this market is the NOAA Storm Prediction Center at spc.noaa.gov.\n\nThis market uses coordinates 41.8781, -87.6298 for Chicago, IL.","outcomes":"[\"Yes\", \"No\"]","outcomePrices":"[\"0.0255\", \"0.9745\"]","active":true,"closed":false,"marketMakerAddress":"","createdAt":"2026-08-31T12:13:00.239781Z","updatedAt":"2026-08-31T14:52:34.032793Z","new":false,"featured":false,"archived":false,"resolvedBy":"0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7","restricted":true,"groupItemTitle":"Chicago, IL","groupItemThreshold":"0","questionID":"0x554c2346e5202b706745a55cb728c11aa1dae48b180550dd0f0e7adb1dffe567","enableOrderBook":true,"orderPriceMinTickSize":0.001,"orderMinSize":5,"liquidityNum":51.74001,"endDateIso":"2026-09-01","startDateIso":"2026-08-31","hasReviewedDates":true,"gameStartTime":"2026-08-31 12:00:00+00","secondsDelay":0,"clobTokenIds":"[\"114867168491112171105074853155526100442679574239396816796621090226602769890326\", \"40986708562170016184986509662981516214521574619747420090963550816741641573535\"]","comboStatus":"disabled","umaBond":"500","umaReward":"5","liquidityClob":51.74001,"makerBaseFee":1000,"takerBaseFee":1000,"customLiveness":21600,"acceptingOrders":true,"negRisk":false,"events":[{"id":"941430","ticker":"which-cities-face-tornado-risk-on-august-31-2026","slug":"which-cities-face-tornado-risk-on-august-31-2026","title":"Which cities face tornado risk on August 31?","description":"This market will resolve to \"Yes\" for each listed city that falls within a tornado probability area rated ≥2% in the NOAA Storm Prediction Center Day 1 Convective Outlook on August 31, 2026. Otherwise, this market will resolve to \"No\".\n\nThe SPC Day 1 Convective Outlook assigns tornado probability percentages (2%, 5%, 10%, etc.) to geographic areas across the US. If a city's coordinates fall inside any area rated 2% or higher, that city resolves \"Yes\". If a city is outside all tornado probability areas, or only within areas rated below 2%, that city resolves \"No\".\n\nThe SPC outlook is published as machine-readable geographic data (GeoJSON) at spc.noaa.gov. Each city's coordinates and the polygon boundaries are publicly verifiable. Borderline cases can be independently confirmed using the polygon data (excluding the hatched SIGN overlay, which is not a probability rating) and the city's listed coordinates. The point-in-polygon test is performed on unprojected WGS84 (EPSG:4326) coordinates, which is the native coordinate system of the SPC GeoJSON data.\n\nResolution is based on the scheduled 01:00 UTC Day 1 Convective Outlook update issued on the following UTC calendar day. The SPC Day 1 outlook covers a 24-hour period from 12:00 UTC to 12:00 UTC the following day. Subsequent revisions published after that scheduled update will not be considered. If the SPC outlook is not published or is unavailable, the market remains open until data is available.\n\nThe resolution source for this market is the NOAA Storm Prediction Center at spc.noaa.gov.","resolutionSource":"https://www.spc.noaa.gov/products/outlook/day1otlk.html","startDate":"2026-08-31T12:13:15Z","creationDate":"2026-08-31T12:15:54.772046Z","endDate":"2026-09-01T12:00:00Z","image":"https://polymarket-upload.s3.us-east-2.amazonaws.com/how-many-tornadoes-in-the-us-in-november-W7XLO0OomR-x.png","icon":"https://polymarket-upload.s3.us-east-2.amazonaws.com/how-many-tornadoes-in-the-us-in-november-W7XLO0OomR-x.png","active":true,"closed":false,"archived":false,"new":false,"featured":false,"restricted":true,"liquidity":1259.88473,"volume":62.64,"openInterest":31.32,"createdAt":"2026-08-31T12:13:00.122718Z","updatedAt":"2026-08-31T14:52:56.313762Z","competitive":0.8193831642570315,"volume24hr":62.64,"volume1wk":62.64,"volume1mo":62.64,"volume1yr":62.64,"enableOrderBook":true,"liquidityClob":1259.88473,"negRisk":false,"commentCount":0,"series":[{"id":"12689","ticker":"tornado-risk-daily","slug":"tornado-risk-daily","title":"Which Cities Face Tornado Risk Today?","seriesType":"single","recurrence":"daily","active":true,"closed":false,"archived":false,"featured":false,"restricted":true,"createdAt":"2026-08-19T15:52:08.994297Z","updatedAt":"2026-08-31T14:53:21.665908Z","volume24hr":7432.766756,"volume":62.64,"liquidity":1259.88473,"commentCount":0,"requiresTranslation":false}],"cyom":false,"showAllOutcomes":true,"showMarketImages":false,"enableNegRisk":false,"automaticallyActive":true,"eventDate":"2026-08-31","startTime":"2026-08-31T12:13:00.02Z","seriesSlug":"tornado-risk-daily","negRiskAugmented":false,"pendingDeployment":false,"deploying":false,"requiresTranslation":false,"eventMetadata":{"context_description":"The National Weather Service Storm Prediction Center’s latest Day 1 convective outlook places only a marginal risk of severe thunderstorms across portions of the central High Plains, Upper Midwest/Great Lakes, and Great Basin on August 31, driven by modest instability (2000–3000 J/kg MLCAPE), weak forcing, and limited shear. Tornado probabilities remain below 2% in these areas, with the primary threats being isolated damaging winds and hail rather than rotation. A weak shortwave trough and surface boundaries provide the main lift, but climatologically low late-August tornado frequency and model consensus limit organized supercell potential. Updated SPC outlooks and any new mesoscale discussions will be the next key data points for traders assessing city-specific resolution criteria.","context_requires_regen":false,"context_updated_at":"2026-08-31T14:51:58.995Z"},"version":"v1"}],"ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-08-31T12:13:16Z","cyom":false,"competitive":0.8162264179434318,"pagerDutyNotificationEnabled":false,"approved":true,"rewardsMinSize":20,"rewardsMaxSpread":4.5,"spread":0.029,"oneHourPriceChange":0.0005,"bestBid":0.011,"bestAsk":0.04,"automaticallyActive":true,"clearBookOnStart":false,"manualActivation":false,"negRiskOther":false,"umaResolutionStatuses":"[]","pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-08-31T12:13:04.229418Z","rfqEnabled":false,"holdingRewardsEnabled":false,"feesEnabled":true,"requiresTranslation":false,"feeType":"weather_fees","feeSchedule":{"exponent":1,"rate":0.05,"takerOnly":true,"rebateRate":0.25},"version":"v1"}]
