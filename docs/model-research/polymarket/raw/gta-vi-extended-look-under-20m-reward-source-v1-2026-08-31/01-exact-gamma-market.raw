ral constraints rather than expecting another record-shattering viral surge, with the November game launch still months away as the next major catalyst.","context_requires_regen":true,"context_updated_at":"2026-08-31T15:47:23.193Z"},"version":"v1"}],"ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-08-28T23:04:41Z","cyom":false,"competitive":0.9669075878072954,"pagerDutyNotificationEnabled":false,"approved":true,"clobRewards":[{"id":"1677431","conditionId":"0xabf7b6d2ce976c0f2c31d0ce931608f3c9b3e3c00468e58ee1d68069bdbaeeff","assetAddress":"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174","rewardsAmount":0,"rewardsDailyRate":531,"startDate":"2026-08-31","endDate":"2500-12-31"}],"rewardsMinSize":200,"rewardsMaxSpread":4.5,"spread":0.01,"oneDayPriceChange":-0.205,"oneHourPriceChange":-0.01,"lastTradePrice":0.68,"bestBid":0.68,"bestAsk":0.69,"automaticallyActive":true,"clearBookOnStart":true,"showGmpSeries":false,"showGmpOutcome":false,"manualActivation":false,"negRiskOther":false,"umaResolutionStatuses":"[]","pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-08-28T23:04:28.228789Z","rfqEnabled":false,"holdingRewardsEnabled":false,"feesEnabled":true,"requiresTranslation":false,"feeType":"culture_fees","feeSchedule":{"exponent":1,"rate":0.05,"takerOnly":true,"rebateRate":0.25},"version":"v1"}]
