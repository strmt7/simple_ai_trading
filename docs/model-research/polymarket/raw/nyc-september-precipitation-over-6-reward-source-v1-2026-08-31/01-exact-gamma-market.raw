ulativeMarkets":false,"pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-08-31T13:44:03.752742Z","requiresTranslation":false,"eventMetadata":{"context_description":"Recent outlooks point to below-average September precipitation in New York City amid a strengthening El Niño, which tends to suppress Atlantic tropical activity and reduce moisture transport into the Northeast. Historical Central Park totals average 4.3 inches with wide year-to-year variability driven by the position of the jet stream, frequency of coastal lows, and occasional tropical remnants. Trader sentiment remains dispersed across the 2–6+ inch brackets because early-month NWS guidance favors drier conditions while longer-range models show limited consensus on whether late-month systems will compensate, leaving no single bin dominant.","context_requires_regen":true,"context_updated_at":"2026-08-31T15:20:40.677Z"},"version":"v1"}],"ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-08-31T13:44:17Z","cyom":false,"competitive":0.9148921570869833,"pagerDutyNotificationEnabled":false,"approved":true,"clobRewards":[{"id":"1732916","conditionId":"0x80cfbda7d19183b6206dd6fefb18cbf0f5877d0f528c422c4dd4897c4c302779","assetAddress":"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174","rewardsAmount":0,"rewardsDailyRate":39,"startDate":"2026-08-31","endDate":"2500-12-31"}],"rewardsMinSize":20,"rewardsMaxSpread":4.5,"spread":0.07,"oneHourPriceChange":-0.05,"lastTradePrice":0.23,"bestBid":0.16,"bestAsk":0.23,"automaticallyActive":true,"clearBookOnStart":true,"showGmpSeries":false,"showGmpOutcome":false,"manualActivation":false,"negRiskOther":false,"umaResolutionStatuses":"[]","pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-08-31T13:44:03.794823Z","rfqEnabled":false,"holdingRewardsEnabled":false,"feesEnabled":true,"requiresTranslation":false,"feeType":"weather_fees","feeSchedule":{"exponent":1,"rate":0.05,"takerOnly":true,"rebateRate":0.25},"version":"v1"}]
