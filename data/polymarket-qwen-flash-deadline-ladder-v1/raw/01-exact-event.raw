33636296495667474\"]","comboStatus":"disabled","umaBond":"500","umaReward":"5","liquidityClob":7.7051,"makerBaseFee":1000,"takerBaseFee":1000,"customLiveness":0,"acceptingOrders":true,"negRisk":false,"ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-08-31T23:25:50Z","cyom":false,"competitive":0.09996001599360256,"pagerDutyNotificationEnabled":false,"approved":true,"rewardsMinSize":50,"rewardsMaxSpread":4.5,"spread":0.9,"oneHourPriceChange":0.02,"bestBid":0.07,"bestAsk":0.97,"automaticallyActive":true,"clearBookOnStart":true,"showGmpSeries":false,"showGmpOutcome":false,"manualActivation":false,"negRiskOther":false,"umaResolutionStatuses":"[]","pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-08-31T23:25:40.299309Z","rfqEnabled":false,"holdingRewardsEnabled":false,"feesEnabled":true,"requiresTranslation":false,"feeType":"tech_fees","feeSchedule":{"exponent":1,"rate":0.04,"takerOnly":true,"rebateRate":0.25},"version":"v1"}],"series":[{"id":"12661","ticker":"next-alibaba-qwen-flash-released-by","slug":"next-alibaba-qwen-flash-released-by","title":"Next Alibaba Qwen Flash Released by","recurrence":"monthly","active":true,"closed":false,"archived":false,"createdAt":"2026-08-14T16:49:21.381171Z","updatedAt":"2026-09-01T01:42:06.86836Z","liquidity":15.1564,"commentCount":2,"requiresTranslation":false}],"tags":[{"id":"106106","label":"Qwen","slug":"qwen","createdAt":"2026-08-14T21:53:25.564061Z","updatedAt":"2026-08-14T21:55:26.29862Z","requiresTranslation":false},{"id":"439","label":"AI","slug":"ai","forceShow":true,"publishedAt":"2023-11-02 23:08:32.469+00","updatedBy":15,"createdAt":"2023-11-02T23:08:32.49Z","updatedAt":"2026-04-17T20:30:49.674936Z","isCarousel":true,"requiresTranslation":false},{"id":"1401","label":"Tech","slug":"tech","forceShow":false,"publishedAt":"2024-02-21 23:06:12.305+00","createdAt":"2024-02-21T23:06:12.324Z","updatedAt":"2026-04-17T20:39:14.21105Z","requiresTranslation":false},{"id":"102729","label":"Alibaba","slug":"alibaba","createdAt":"2025-10-20T14:30:45.748142Z","updatedAt":"2026-04-17T20:46:56.500116Z","requiresTranslation":false},{"id":"105579","label":"AI Releases","slug":"ai-releases","forceShow":false,"createdAt":"2026-07-07T21:48:04.040412Z","updatedAt":"2026-07-07T21:50:01.919624Z","isCarousel":false,"requiresTranslation":false}],"cyom":false,"showAllOutcomes":true,"showMarketImages":false,"enableNegRisk":false,"automaticallyActive":true,"seriesSlug":"next-alibaba-qwen-flash-released-by","gmpChartMode":"default","negRiskAugmented":false,"estimateValue":false,"cumulativeMarkets":false,"pendingDeployment":false,"deploying":false,"requiresTranslation":false,"eventMetadata":{"context_description":"**Alibaba’s Qwen team released Qwen3.8-Flash and the open-weight Qwen3.8-Flash-Next on August 26, 2026, positioning the model as a direct architectural preview for the upcoming Qwen4 series.** \n\nThis multimodal Mixture-of-Experts (MoE) model uses 125B total parameters (6B activated per token) plus a 51B N-gram embedding layer, hybrid Gated DeltaNet + Qwen Sparse Attention (QSA), gated residuals, and the Muon optimizer. It delivers strong gains in agentic coding (SWE-bench Pro 62.5), office tasks (CoWorkBench 73.9), and multimodal benchmarks while requiring roughly one-ninth the training compute of Qwen3.7-Plus. The native 262k-token context extends to 1M via YaRN, with production API pricing set at very low levels ($0.16/$0.47 per million tokens). \n\nTraders are focused on Alibaba’s accelerated release cadence—following Qwen3.8-Max earlier in August and earlier 3.7/3.6 Flash iterations—plus open-weight availability on Hugging Face that speeds developer testing and fine-tuning. Competitive pressure from DeepSeek-V4-Flash and Claude Opus 4.6, combined with expected near-term API rollout and potential Qwen4 milestones, keeps sentiment centered on rapid iteration and cost-efficiency leadership in the Flash lineup.","context_requires_regen":true,"context_updated_at":"2026-09-01T01:20:35.206Z"},"version":"v1"}
